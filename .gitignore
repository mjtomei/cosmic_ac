# Corpus-derived text that must not be republished: the redraw upload batch
# (Hansard segments as RTF; rebuild with build_cafed_ctl_redraw.py --build)
# and the scored-segment capture (full transcript text; rebuild with
# build_member_vectors.py).
analysis/s10/pangram_cafed_ctl2/
analysis/s10/scored_seg_texts.jsonl

# provinces/ and us/ hold licensed transcripts, scraped third-party prose and
# download machinery. Default-ignore everything, then re-include our own code
# and the study-produced covariate outputs (structured fields we derived; at
# most short attributed quotes). The pre-push hook enforces the same boundary
# independently.
analysis/s10/provinces/*
!analysis/s10/provinces/*.py
!analysis/s10/provinces/OCCUPATION_CODING.md
!analysis/s10/provinces/occupation_strings.json
!analysis/s10/provinces/occupation_coding.json
!analysis/s10/provinces/class_origin.json
!analysis/s10/provinces/member_allsource.json
!analysis/s10/provinces/member_bios.json
!analysis/s10/provinces/wiki_depth.json
!analysis/s10/provinces/aus_state_covariates.csv
!analysis/s10/provinces/*_education*.json
!analysis/s10/provinces/*_education*.csv
!analysis/s10/provinces/*_education_occupation.json
!analysis/s10/provinces/ns_member_bios.json
!analysis/s10/provinces/sk_legislature_bios.json
analysis/s10/us/*
!analysis/s10/us/*.py

# Pangram upload batches and screen pools: verbatim Hansard text, rebuildable
# from the corpora + build scripts. The generation PROMPTS are 45-word Hansard
# excerpts and stay out too; the generated continuations themselves are our
# own model output and are tracked.
analysis/s10/web_batches/
analysis/s10/gov_screen_pool.json
analysis/s10/go_pos_screen_pool.json
analysis/s10/pangram_gov_variants.csv
analysis/s10/rlhf_gen/prompts.json
analysis/s10/rlhf_gen/prompts_all.json
# Haiku 4.5 traces failed the generation audit (template dupes + degenerate
# "This" padding, VECTOR-ANALYSIS.md) and are excluded from every table;
# kept on disk as the audit's evidence, not tracked.
analysis/s10/claude_gen_old/haiku_c*.json
