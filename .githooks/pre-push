#!/usr/bin/env bash
# pre-push: blocks pushes that contain secrets, corpus/transcript data, or oversized files.
# Wired via: git config core.hooksPath .githooks   (must be re-run in fresh clones)
# Bypass (only when you are certain): git push --no-verify
#
# Context: this repo is public. Hansard/parliamentary corpora (uk/ca/ie/us XML and
# segments_*.jsonl extracts) are redistributable only under their own licences and
# once nearly went out in a push (3.4GB). This hook is the backstop for that class
# of mistake, plus the usual secret-leak patterns.

set -u
zero=0000000000000000000000000000000000000000
MAX_BLOB_MB=10           # any single new blob larger than this blocks the push
CORPUS_TEXT_MB=2         # .jsonl/.xml/.txt/.csv blobs larger than this look like corpus data
fail=0

say() { printf '%s\n' "$*" >&2; }

check_range() {
  # $@ = rev-list args covering exactly the commits being pushed
  local objects new_files

  # --- 1a. Corpus-shaped paths ---
  # Enumerate paths from the COMMITS, not from rev-list --objects: git stores one
  # object per unique content, so identical-content files (or a corpus file whose
  # bytes already exist in history) appear there exactly once, under a single
  # arbitrary path. Path filtering off that list silently misses the duplicates.
  # xml_deep/xml_hist hold thousands of individually-small files, so the size
  # gates below never fire on them — the path rule is the only thing catching
  # them. Same for scraped provincial HTML/PDF and the US zips.
  local paths
  paths=$(git log --pretty=format: --name-only --no-renames "$@" 2>/dev/null | sed '/^$/d' | sort -u)
  while IFS= read -r path; do
    [ -n "$path" ] || continue
    # Corpus directories hold licensed transcripts AND the scripts that fetch
    # and extract them. The scripts are our own work, carry no source text, and
    # are the only path from a recorded seg_id back to the text it names --
    # without them 17 of 21 chambers are unreproducible. Allow *.py through the
    # path rule; the content backstop below now scans .py too, so a script that
    # embeds transcript prose is still caught on content rather than location.
    case "$path" in
      analysis/s10/us/*.py|analysis/s10/provinces/*.py|\
      analysis/s10/permeation/*.py)
        : ;;                                    # extraction code — allowed
      # Study-produced covariate outputs (2026-08-14): structured fields WE
      # derived (education levels, occupation codes, article lengths, the
      # double-blind coding and its methods note). No transcript text; at most
      # short attributed quotes in member_allsource evidence entries. The
      # content backstop below still scans them. Raw scraped bio prose
      # (bc_member_bios_raw, on_edu/, pool_bios_raw, ...) stays blocked.
      analysis/s10/provinces/OCCUPATION_CODING.md|\
      analysis/s10/provinces/occupation_strings.json|\
      analysis/s10/provinces/occupation_coding.json|\
      analysis/s10/provinces/occupation_coding_v2.json|\
      analysis/s10/provinces/class_origin.json|\
      analysis/s10/provinces/member_allsource.json|\
      analysis/s10/provinces/member_bios.json|\
      analysis/s10/provinces/wiki_depth.json|\
      analysis/s10/provinces/aus_state_covariates.csv|\
      analysis/s10/provinces/*_education*.json|\
      analysis/s10/provinces/*_education*.csv|\
      analysis/s10/provinces/ns_member_bios.json|\
      analysis/s10/provinces/occupation_coding_missing9.json|\
      analysis/s10/provinces/sk_legislature_bios.json)
        : ;;                                    # covariate outputs — allowed
      # Reproduction substrate (2026-09-13, Matthew's call): the text a third
      # party needs to CHECK our scoring, which no committed script can
      # regenerate for them.
      #   detector_bench_input / _scored_input — bypass variants. Model
      #     rewrites; bypass_rewrite.py seeds only its example choice, not the
      #     sampling, so re-running produces different strings and the arm
      #     becomes uncheckable without these.
      #   detector_bench_controls — the 1,255 pre-2022 human controls. Each row
      #     carries its seg_id, but re-extracting them needs all 20 chambers'
      #     corpora, so in practice the arm ships with them or not at all.
      #   flagged_hits_pool — the estimator's 316 hits. Its builder reads the
      #     pangram_* RTF submissions, which are gitignored, so nobody
      #     off-repo can rebuild it either.
      # Licence: verbatim rows are accurate, non-official, non-commercial
      # reproduction, which is what the Canadian Speaker's Permission and the
      # NB research clause permit; the modified rows rely on fair dealing and
      # are labelled as adaptations in DATA-NOTICE.md. See SOURCE-LICENCES.md.
      analysis/s10/detector_bench_input.jsonl|\
      analysis/s10/detector_bench_scored_input.jsonl|\
      analysis/s10/detector_bench_controls.jsonl|\
      analysis/s10/flagged_hits_pool.json)
        : ;;                                    # reproduction substrate — allowed
      analysis/*/xml/*|analysis/*/*/xml/*|analysis/*/xml_*/*|analysis/*/*/xml_*/*|\
      analysis/*/zips/*|analysis/*/*/zips/*|\
      analysis/s10/us/*|analysis/s10/provinces/*|analysis/s10/permeation/*|\
      */segments_*.jsonl|segments_*.jsonl|\
      analysis/*/pdfs*/*|analysis/*/pangram_*/*|*.pyc|*/__pycache__/*)
        say "BLOCKED: corpus/artifact path in push: $path"
        fail=1
        continue
        ;;
    esac

    # Third-party documents. The outline .docx files are Matthew's own drafting
    # documents (the Cosmic AC outline, worked in parallel outside this repo),
    # whitelisted 2026-10-27 after a full-history scan flagged them as the
    # rule's only standing false positives.
    # Acquired papers, vendor reports and scraped pages
    # are read here, quoted in notes, and never redistributed from a public
    # repo — most carry no licence permitting it. Our OWN renders are the only
    # documents that belong in git, so this is a whitelist, not a blacklist:
    # anything that is not a known project deliverable gets stopped.
    case "$path" in
      the-performance-commons*.pdf|assets-rents-socialized-buildout*.pdf|\
      dataflow-vs-heterogeneous-architecture.pdf|build/*.pdf|\
      analysis/*/REVIEW*.pdf|analysis/*/METHODOLOGY*.pdf|REVIEW-RESPONSES.pdf|\
      towards-the-cosmic-ac-outline*.docx)
        : ;;                                    # our own renders — allowed
      *.pdf|*.epub|*.mobi|*.docx|*.doc|*.pptx|*.djvu)
        say "BLOCKED: third-party document (not a known project deliverable): $path"
        say "         quote it in reading/notes/ instead of committing the file."
        fail=1
        continue
        ;;
    esac

    # Scratch scrape/download areas: whole-page HTML and fetched sources.
    case "$path" in
      analysis/_scratch_ins/*|fetched/*|*/pangram_web_scans/*)
        say "BLOCKED: scratch/scraped download area: $path"
        fail=1
        continue
        ;;
    esac
  done <<< "$paths"

  # --- 1b. Oversized blobs ---
  # Enumerate (blob, path) pairs from `git log --raw`, NOT from
  # `git rev-list --objects`. Same reason 1a above stopped using rev-list, and
  # the fix was simply never carried down here: rev-list lists each unique
  # CONTENT once, and omits a blob that is already reachable from the range's
  # starting point. So committing a second copy of a corpus file -- or
  # re-adding, renaming, or restoring one whose bytes exist anywhere in
  # history -- produced a path that 1a checked but that NEVER reached the size
  # gate or the content backstop below. Caught 2026-10-27 by a test that
  # copied a 93KB verbatim-Hansard file to a new name: 1a passed it (the name
  # matches no corpus pattern), and 1b never saw it at all.
  # --raw gives one line per path per commit with the post-image blob, so
  # duplicate content is listed under every path that carries it. -M0 disables
  # rename detection, which would otherwise report a moved corpus file as R
  # with no new blob to scan.
  objects=$(git log --pretty=format: --raw --no-renames -M0 "$@" 2>/dev/null) || return 0
  new_files=$(printf '%s\n' "$objects" | awk -F'\t' '
      /^:/ { split($1, a, " ");
             if (a[5] ~ /^[AMT]/ && a[4] !~ /^0+$/) print a[4], $2 }' \
    | sort -u -k2)

  while IFS=' ' read -r sha path; do
    [ -n "$path" ] || continue
    size=$(git cat-file -s "$sha" 2>/dev/null) || continue
    if [ "$size" -gt $((MAX_BLOB_MB * 1024 * 1024)) ]; then
      say "BLOCKED: $path is $((size / 1024 / 1024))MB (limit ${MAX_BLOB_MB}MB) — large data files stay out of the public repo"
      fail=1
    fi
    # Model-generated continuations (2026-08-14): rlhf_gen*/ and claude_gen/
    # hold text PRODUCED BY models for the alignment and class arms — our own
    # output, not licensed source text, and the artifact behind §4.7 and the
    # vector analysis. They legitimately look like bulk prose, so they are
    # exempt from the corpus-text heuristics below. The 10MB cap above still
    # applies, and the prompt pools (Hansard excerpts) are gitignored.
    case "$path" in
      analysis/s10/claude_gen/*.json|analysis/s10/claude_gen_old/*.json|\
      analysis/s10/rlhf_gen/*.json|analysis/s10/rlhf_gen_180/*.json|\
      analysis/s10/covariates_tier1*.json|analysis/s10/rosters/*.json|\
      analysis/s10/covariates_missing9*.json|\
      analysis/s10/fpw_member_year.json|\
      analysis/s10/prereg_member_table.json|\
      analysis/s10/soc_coding_new.json|\
      analysis/s10/provinces/occupation_coding*.json|\
      analysis/s10/detector_bench_input.jsonl|\
      analysis/s10/detector_bench_scored_input.jsonl|\
      analysis/s10/detector_bench_controls.jsonl|\
      analysis/s10/flagged_hits_pool.json|\
      analysis/s10/market_anchors/occupation_titles.txt|\
      analysis/s10/provinces/member_allsource.json|\
      analysis/s10/pangram_gov_seeds.csv|\
      analysis/s10/pangram_gov_all_b0.csv|\
      analysis/s10/pangram_gov_all_b1.csv|\
      analysis/s10/pangram_v3_b0.csv|\
      analysis/s10/pangram_v3_b1.csv|\
      analysis/s10/pangram_bypass.csv|\
      analysis/s10/stage5_evasion_pairs.json|\
      analysis/s10/stage5_grade_items.json|\
      analysis/s10/se_segments.jsonl|\
      analysis/s10/wp_extracts.json)
        # 2026-10-27: eleven files the rewritten backstop newly flags, all
        # already in the published tree and now itemised in DATA-NOTICE.md.
        # Audited file by file before allowlisting:
        #   pangram_gov_all_b0/b1, pangram_v3_b0/b1 — 329 rows, every one
        #     matched against the known variant set: model rewrites, no
        #     originals. CA-FED and NB.
        #   pangram_bypass.csv — 40 NB variants; no row matches any segment in
        #     the 112 local corpus files, consistent with the run's name.
        #   pangram_gov_seeds.csv — 48 rows of VERBATIM CA-FED Hansard (one
        #     traced to ca/xml/451_048.xml). Published under the Speaker's
        #     Permission, same instrument as detector_bench_input's originals.
        #   stage5_evasion_pairs/grade_items — 35 original+variant pairs and
        #     the blinded 70-item grading subset drawn from them.
        #   se_segments.jsonl — fully synthetic (speaker "SYNTHETIC",
        #     Mistral-7B-Instruct-v0.3); no parliamentary text at all.
        #   wp_extracts.json — 58 full Wikipedia articles, CC BY-SA; see the
        #     Wikipedia row in SOURCE-LICENCES.md for the attribution and
        #     share-alike terms this repo relies on.
        #   provinces/member_allsource.json — false positive: 1,740 short
        #     attributed evidence quotes at 9.5% density, caught only by the
        #     sentence-count rule. Already allowlisted in 1a.
        # No row in any of them comes from a restrictive chamber (BC, VIC,
        # QLD, or the four that publish no terms) — checked by seg_id prefix.
        # 2026-09-13: the reproduction substrate allowlisted in 1a must clear
        # the size gate and the prose backstop as well, or the path rule alone
        # never takes effect. occupation_titles.txt is O*NET-SOC 30.3 (CC-BY
        # 4.0) and trips the backstop on its occupation DESCRIPTIONS — a
        # standing false positive, recorded in SOURCE-LICENCES.md.
        # 2026-08-21 additions: covariates_missing9* (same class as
        # covariates_tier1), fpw_member_year (per-member-year counts, no
        # prose), prereg_member_table (derived join; only short bio-derived
        # occupation strings), soc_coding_new (double-blind coding output,
        # same class as provinces/occupation_coding*). All cross the 2MB
        # gate by breadth of coverage, not by carrying source text.
        # covariates_tier1*: study-derived member covariates (same class as
        # the allowlisted provinces/member_allsource.json — structured fields
        # plus short attributed evidence quotes, no transcript text); rosters:
        # speaker keys and word counts only. Both cross the 2MB size gate
        # purely by breadth of coverage.
        continue ;;
    esac
    if false; then :
    elif [ "$size" -gt $((CORPUS_TEXT_MB * 1024 * 1024)) ]; then
      case "$path" in
        *.jsonl|*.xml|*.txt|*.csv|*.json|*.tsv)
          say "BLOCKED: $path ($((size / 1024 / 1024))MB) looks like corpus data — likely copyrighted/licensed source text"
          fail=1
          continue
          ;;
      esac
    fi

    # Content backstop. Extracted-speech pools (band_screen_pool.json,
    # quality_expansion/pool.json, align_ratio/items.json …) carry verbatim
    # Hansard under 10MB, and new ones keep appearing under new names — so
    # sniff the content instead of chasing directory names.
    #
    # REWRITTEN 2026-10-27. The previous heuristic counted runs of 300+
    # characters drawn from [A-Za-z,;'’ ()-] — a class that EXCLUDES the
    # period, so a hit needed 300 characters of prose with no sentence end.
    # Real prose almost never does, and the measured consequence was that the
    # backstop was close to inert: ca/segments_ca_en.jsonl, 305MB of pure
    # Hansard, scored 5 in its first 2MB against a threshold of 20, and seven
    # text-bearing files already in the tree scored 2-13. Only the 10MB size
    # gate was actually stopping corpus data; a 5MB pool would have walked
    # through. It fired on band_screen_pool (220) and gov_screen_pool (142)
    # purely because those two happen to be formatted differently.
    #
    # The replacement measures what bulk transcript actually looks like:
    # sentence-shaped spans (60+ chars of prose ending in . ? !) and the share
    # of the file they occupy. Calibrated over every tracked file plus the
    # gitignored pools:
    #   verbatim/variant pools   43-79% of bytes in sentences
    #   derived results, worst   39% (element_audit_unanchored.json)
    #   all 86 extraction .py    0 sentences
    # Three ways to trip it, so neither density nor volume alone can be
    # dodged: dense prose at any size, moderately dense at volume, or sheer
    # sentence count (which is what catches segment-per-row corpus files like
    # segments_ca_en, whose JSON keys dilute density to 25%).
    # Scan floor drops 100KB -> 40KB: pangram_bypass.csv (57KB, 69%) and
    # se_segments.jsonl (58KB) sat under the old floor entirely.
    scan_floor=40960
    case "$path" in *.py) scan_floor=0 ;; esac
    if [ "$size" -gt "$scan_floor" ]; then
      case "$path" in
        *.json|*.jsonl|*.csv|*.tsv|*.txt|*.py)
          local sents schars scanned density
          read -r sents schars <<<"$(git cat-file -p "$sha" 2>/dev/null \
                  | head -c 2000000 \
                  | grep -o -E '[A-Za-z][A-Za-z,;:'"'"'’ ()-]{59,}[.?!]' \
                  | awk '{n++; c+=length($0)} END {print n+0, c+0}')"
          scanned=$size
          [ "$scanned" -gt 2000000 ] && scanned=2000000
          density=$(( schars * 100 / scanned ))
          # .py: any code carrying five sentences at 25% density has a
          # transcript pasted into it. Measured zero across all 86 scripts.
          if [ "${path##*.}" = "py" ]; then
            if [ "${sents:-0}" -ge 5 ] && [ "$density" -ge 25 ]; then
              say "BLOCKED: $path holds $sents sentences of prose (${density}% of the file) — reads as transcript text pasted into code"
              fail=1
            fi
          elif { [ "${sents:-0}" -ge 100 ] && [ "$density" -ge 55 ]; } \
            || { [ "${sents:-0}" -ge 500 ] && [ "$density" -ge 40 ]; } \
            || [ "${sents:-0}" -ge 1200 ]; then
            say "BLOCKED: $path holds bulk verbatim prose ($sents sentences, ${density}% of the file) — reads as extracted transcript text, not derived results"
            fail=1
          fi
          ;;
      esac
    fi
  done <<< "$new_files"

  # --- 2. Secrets in the added lines of the pushed commits ---
  if command -v gitleaks >/dev/null 2>&1; then
    if ! gitleaks detect --source . --log-opts "$(printf '%s ' "$@")" --no-banner --redact >/dev/null 2>&1; then
      say "BLOCKED: gitleaks found potential secrets in the pushed commits (run: gitleaks detect --log-opts '$*')"
      fail=1
    fi
  else
    # Fallback: grep added lines for high-confidence secret shapes.
    local added
    # --binary-files=text: without it grep bails out of a diff the moment it
    # sees a binary hunk, printing "binary file matches" and leaving the rest
    # of that diff unscanned — the scan has to be deterministic, not skipped.
    added=$(git log -p --unified=0 --pretty=format: "$@" 2>/dev/null \
            | grep --binary-files=text '^+' | grep --binary-files=text -v '^+++')
    local patterns=(
      'AKIA[0-9A-Z]{16}'                                   # AWS access key
      'ghp_[A-Za-z0-9]{36}'                                # GitHub PAT
      'github_pat_[A-Za-z0-9_]{22,}'                       # GitHub fine-grained PAT
      'sk-ant-[A-Za-z0-9_-]{20,}'                          # Anthropic
      'sk-[A-Za-z0-9]{40,}'                                # OpenAI-style
      'AIza[0-9A-Za-z_-]{35}'                              # Google API key
      'xox[baprs]-[0-9A-Za-z-]{10,}'                       # Slack token
      'hooks\.slack\.com/services/T[A-Za-z0-9_/]+'         # Slack webhook
      '-----BEGIN( [A-Z]+)? PRIVATE KEY-----'              # private key material
      '(api[_-]?key|secret[_-]?key|auth[_-]?token|password)["'"'"']?\s*[:=]\s*["'"'"'][A-Za-z0-9+/_-]{20,}["'"'"']'
    )
    local p hits
    for p in "${patterns[@]}"; do
      hits=$(printf '%s\n' "$added" | grep --binary-files=text -E -c -e "$p" || true)
      if [ "${hits:-0}" -gt 0 ]; then
        say "BLOCKED: possible secret matching /$p/ in pushed commits ($hits line(s))"
        fail=1
      fi
    done
  fi
}

while read -r local_ref local_sha remote_ref remote_sha; do
  [ "$local_sha" = "$zero" ] && continue   # ref deletion — nothing to scan
  if [ "$remote_sha" = "$zero" ]; then
    # New remote branch: scan only commits not already on any remote.
    check_range "$local_sha" --not --remotes
  else
    check_range "$remote_sha..$local_sha"
  fi
done

if [ "$fail" -ne 0 ]; then
  say ""
  say "Push blocked by .githooks/pre-push. Fix history (git filter-repo) or, if this is"
  say "a confirmed false positive, push with --no-verify."
  exit 1
fi
exit 0
